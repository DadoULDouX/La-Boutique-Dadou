{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "regions": ["dub1"],
  "functions": {
    "index.py": {
      "maxDuration": 30,
      "includeFiles": "{app,public}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "same-origin"}
      ]
    }
  ]
}
